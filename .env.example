# Copy to .env and fill in. NEVER commit .env.
# Generate each secret with:  openssl rand -hex 32
SECRET_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=

# Gunicorn workers (about 1 per vCPU; requires SECRET_KEY above)
WORKERS=4

# Set to true once the site is served over HTTPS (docker-compose.prod.yml)
SESSION_COOKIE_SECURE=false

# Copy to .env on the server (cp deploy/.env.production.example .env) and fill in. NEVER commit .env.
# Generate each secret with:  openssl rand -hex 32

SECRET_KEY=
REDIS_PASSWORD=

# AWS RDS (MariaDB 10.11). Use the RDS endpoint shown in the AWS console.
# Special characters in the password must be URL-encoded (or just use letters and digits).
DATABASE_URL=mysql+pymysql://ctfd:REPLACE_PASSWORD@REPLACE-ENDPOINT.rds.amazonaws.com:3306/ctfd?ssl_ca=/etc/ssl/rds/global-bundle.pem&ssl_verify_cert=true&ssl_verify_identity=true

# App workers. Rule of thumb: about 3/4 of the server's vCPUs (the rest is for nginx, Redis and the OS).
#   2 vCPU -> 2   |   8 vCPU -> 6   |   16 vCPU -> 12   |   32 vCPU -> 24   |   64 vCPU (c8i.16xlarge) -> 48
# Every worker keeps up to (POOL_SIZE + MAX_OVERFLOW) database connections open, so make sure
# WORKERS x (POOL_SIZE + MAX_OVERFLOW) stays below the RDS max_connections (see deploy/README.md).
WORKERS=4
SQLALCHEMY_POOL_SIZE=6
SQLALCHEMY_MAX_OVERFLOW=4

# Rate limits are counted per IP address. If many players share one network (a college lab behind one
# public IP), keep these high or they will see "Too many requests":
RATELIMIT_LOGIN=60,5
RATELIMIT_REGISTER=60,5
RATELIMIT_EVENTS=5000,60

# Optional off-server copy of backups (needs the aws CLI and an IAM role on the server)
# BACKUP_S3_URI=s3://your-bucket/zerodayctf
